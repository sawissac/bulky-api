idle\"\n          ? T.border\n          : c.status === \"pending\"\n            ? T.accent\n            : statusColor(c.statusCode, T);\n      if (heat) {\n        const t = Math.min(1, heatLevel + (i / 3) * (1 - heatLevel) * 0.6);\n        const r = Math.round(220 * t + 0 * (1 - t));\n        const g = Math.round(50 * t + 200 * (1 - t));\n        const b = Math.round(50 * t + 160 * (1 - t));\n        bg = `rgb(${r},${g},${b})`;\n      } else if (overflow) {\n        bg = [T.accent, T.warn, T.error, T.error][i] ?? T.error;\n      }\n      return { key: i, bg, status: c.status };\n    });\n  })", "is_member_call": false, "source_file": "/Users/sawissac/Documents/GitHub/bulky-api/src/features/response-panel/components/ResponsePanel.tsx", "source_location": "L369"}, {"caller_nid": "components_responsepanel_responsepanel", "callee": "map", "is_member_call": true, "source_file": "/Users/sawissac/Documents/GitHub/bulky-api/src/features/response-panel/components/ResponsePanel.tsx", "source_location": "L428"}, {"caller_nid": "components_responsepanel_responsepanel", "callee": "map", "is_member_call": true, "source_file": "/Users/sawissac/Documents/GitHub/bulky-api/src/features/response-panel/components/ResponsePanel.tsx", "source_location": "L469"}, {"caller_nid": "components_responsepanel_responsepanel", "callee": "map", "is_member_call": true, "source_file": "/Users/sawissac/Documents/GitHub/bulky-api/src/features/response-panel/components/ResponsePanel.tsx", "source_location": "L499"}, {"caller_nid": "components_responsepanel_responsepanel", "callee": "keys", "is_member_call": true, "source_file": "/Users/sawissac/Documents/GitHub/bulky-api/src/features/response-panel/components/ResponsePanel.tsx", "source_location": "L515"}, {"caller_nid": "components_responsepanel_responsepanel", "callee": "map", "is_member_call": true, "source_file": "/Users/sawissac/Documents/GitHub/bulky-api/src/features/response-panel/components/ResponsePanel.tsx", "source_location": "L550"}, {"cal